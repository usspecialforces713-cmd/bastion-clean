# Supabase > Project Settings > Database > Connection string.
# Prefer the Session Pooler URI if your Vercel functions use IPv4.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Generate a long random secret (at least 32 characters). Keep it server-side.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional. Do not set to disable for Supabase.
PGSSLMODE=require
